# Copier ce fichier en .env et renseigner les valeurs.
# Le .env ne doit jamais etre commite (il est dans .gitignore).

# MongoDB Atlas
DB_USERNAME=utilisateur
DB_PASSWORD=motdepasse
DB_NAME=nom_de_la_base
DB_CLUSTER=cluster0.xxxxx.mongodb.net

# Alternative : chaine de connexion complete.
# Si MONGODB_URI est renseignee, elle est utilisee telle quelle et les quatre
# variables ci-dessus sont ignorees (sauf DB_NAME, qui reste la base ciblee).
# Utile quand le reseau ne resout pas les enregistrements DNS SRV
# (erreur "querySrv EREFUSED") : sur Atlas, desactivez "SRV Connection String"
# pour obtenir une chaine mongodb:// classique.
# MONGODB_URI=

# Cle de signature des jetons JWT : une chaine longue et aleatoire.
# Generer par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY_TOKEN=

# Cle utilisee pour le HMAC des adresses e-mail.
# Attention : la modifier rend les comptes existants introuvables.
CRYPTOJS_EMAIL=

# Port d'ecoute (3000 par defaut)
PORT=3000
